# ~/.config/ghostty/config

# --- Theme & Colors ---
theme = Everforest Dark Hard

# Matching TMUX Everforest Hard palette
background = #272e33
foreground = #d3c6aa
selection-background = #3d484d
selection-foreground = #fff9e8

# --- Text & Font ---
font-family = JetBrainsMono Nerd Font Mono
font-size = 13
font-feature = -calt
font-feature = -liga

# --- Window Look & Feel ---
window-padding-x = 8
window-padding-y = 8
window-decoration = false
window-background-opacity = 0.95
window-background-blur-radius = 20

# --- Behavior ---
mouse-scroll-multiplier = precision:1,discrete:1
copy-on-select = true
confirm-close-surface = false

# --- Default Shell ---
command = /snap/bin/nu
