# ~/.config/ghostty/config

# --- Theme & Colors ---
# active-theme = dark
config-file = ~/.config/ghostty/theme.conf

# --- Text & Font ---
font-family = JetBrainsMono Nerd Font Mono
font-size = 13
font-feature = -calt
font-feature = -liga

# --- Window Look & Feel ---
window-padding-x = 8
window-padding-y = 8
window-decoration = false
background-opacity = 0.95
background-blur = true

# --- Behavior ---
mouse-scroll-multiplier = precision:1,discrete:1
copy-on-select = true
confirm-close-surface = false

# --- Default Shell ---
command = /usr/bin/nu
