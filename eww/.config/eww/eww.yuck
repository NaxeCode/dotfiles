;; ─────────────────────────────────────────────────────────────────────────────
;; Variables
;; ─────────────────────────────────────────────────────────────────────────────

;; Magic variables (EWW_CPU, EWW_RAM, EWW_DISK, EWW_TIME) update every 2s automatically.
;; Note: EWW_CPU.cores[N].freq is in MHz. EWW_RAM.used_mem/total_mem are in bytes.

;; Average CPU frequency (MHz → GHz)
(defpoll cpu-freq
  :interval "2s"
  :initial "0.0"
  `awk '{sum+=$1;c++}END{printf "%.2f",sum/c/1000000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq`)

(defpoll cpu-temp
  :interval "3s"
  :initial "0"
  `awk '{printf "%d", $1/1000}' /sys/class/hwmon/hwmon3/temp1_input`)

;; AMD GPU — sourced from sysfs
(defpoll gpu-usage
  :interval "2s"
  :initial "0"
  `cat /sys/class/drm/card1/device/gpu_busy_percent`)

(defpoll gpu-freq
  :interval "2s"
  :initial "0.0"
  `awk '{printf "%.2f", $1/1e9}' /sys/class/hwmon/hwmon2/freq1_input`)

(defpoll gpu-temp
  :interval "3s"
  :initial "0"
  `awk '{printf "%d", $1/1000}' /sys/class/hwmon/hwmon2/temp1_input`)

(defpoll vram-used
  :interval "5s"
  :initial "0.0"
  `awk '{printf "%.1f", $1/1073741824}' /sys/class/drm/card1/device/mem_info_vram_used`)

(defpoll vram-total
  :interval "30s"
  :initial "24.0"
  `awk '{printf "%.0f", $1/1073741824}' /sys/class/drm/card1/device/mem_info_vram_total`)

(defpoll vram-perc
  :interval "5s"
  :initial "0"
  `awk 'NR==1{u=$1}END{"cat /sys/class/drm/card1/device/mem_info_vram_total"|getline t;printf "%d",u*100/t}' /sys/class/drm/card1/device/mem_info_vram_used`)

(defpoll vram-ctrl-perc
  :interval "2s"
  :initial "0"
  `cat /sys/class/drm/card1/device/mem_busy_percent`)

(defpoll vram-temp
  :interval "3s"
  :initial "0"
  `awk '{printf "%d", $1/1000}' /sys/class/hwmon/hwmon2/temp3_input`)

;; Volume
(defpoll volume
  :interval "2s"
  :initial "0"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2*100}'`)

(defpoll muted
  :interval "2s"
  :initial "false"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo "true" || echo "false"`)

;; Network throughput — delta over 1s via /proc/net/dev (wlan0)
(defpoll net-up
  :interval "3s"
  :initial "0 KB/s"
  `bash -c 'r1=$(awk "/wlan0/{print \$10}" /proc/net/dev); sleep 1; r2=$(awk "/wlan0/{print \$10}" /proc/net/dev); d=$((r2-r1)); [ $d -gt 1048576 ] && printf "%.1f MB/s" $(echo "$d/1048576" | bc -l) || printf "%d KB/s" $((d/1024))'`)

(defpoll net-down
  :interval "3s"
  :initial "0 KB/s"
  `bash -c 'r1=$(awk "/wlan0/{print \$3}" /proc/net/dev); sleep 1; r2=$(awk "/wlan0/{print \$3}" /proc/net/dev); d=$((r2-r1)); [ $d -gt 1048576 ] && printf "%.1f MB/s" $(echo "$d/1048576" | bc -l) || printf "%d KB/s" $((d/1024))'`)


;; ─────────────────────────────────────────────────────────────────────────────
;; Widgets
;; ─────────────────────────────────────────────────────────────────────────────

(defwidget clock-widget []
  (box :class "clock-section"
       :orientation "v"
       :halign "center"
       :space-evenly false
    (label :class "clock-time"
           :text {formattime(EWW_TIME, "%H:%M")})
    (label :class "clock-date"
           :text {formattime(EWW_TIME, "%A, %B %d")})))

(defwidget stat-bar [value bar-class]
  (scale :class bar-class
         :value value
         :min 0
         :max 100
         :draw-value false
         :orientation "h"))

;; ── CPU card ──────────────────────────────────────────────────────────────────
(defwidget cpu-card []
  (box :class "module-card"
       :orientation "v"
       :space-evenly false
       :hexpand true
    (label :class "module-title" :text "CPU" :halign "start")
    (label :class "stat-value cpu-color"
           :text "${round(EWW_CPU.avg, 1)}%"
           :halign "start")
    (stat-bar :value {EWW_CPU.avg} :bar-class "cpu-bar")
    (label :class "stat-sub"
           :text "${cpu-freq} GHz  ·  ${cpu-temp}°C"
           :halign "start")))

;; ── GPU card ──────────────────────────────────────────────────────────────────
(defwidget gpu-card []
  (box :class "module-card"
       :orientation "v"
       :space-evenly false
       :hexpand true
    (label :class "module-title" :text "GPU" :halign "start")
    (label :class "stat-value gpu-color"
           :text "${gpu-usage}%"
           :halign "start")
    (stat-bar :value {gpu-usage} :bar-class "gpu-bar")
    (label :class "stat-sub gpu-color"
           :text "${gpu-freq} GHz  ·  ${gpu-temp}°C"
           :halign "start")
    (label :class "module-title" :text "VRAM" :halign "start")
    (label :class "stat-value vram-color"
           :text "${vram-perc}%"
           :halign "start")
    (stat-bar :value {vram-perc} :bar-class "vram-bar")
    (label :class "stat-sub vram-color"
           :text "${vram-used} / ${vram-total} GiB  ·  ctrl ${vram-ctrl-perc}%  ·  ${vram-temp}°C"
           :halign "start")))

;; ── System card ───────────────────────────────────────────────────────────────
(defwidget system-card []
  (box :class "module-card"
       :orientation "v"
       :space-evenly false
       :hexpand true
    (label :class "module-title" :text "RAM" :halign "start")
    (label :class "stat-value ram-color"
           :text "${round(EWW_RAM.used_mem_perc, 1)}%"
           :halign "start")
    (stat-bar :value {EWW_RAM.used_mem_perc} :bar-class "ram-bar")
    (label :class "stat-sub"
           :text "${round(EWW_RAM.used_mem / 1073741824, 1)} / ${round(EWW_RAM.total_mem / 1073741824, 1)} GiB"
           :halign "start")
    (label :class "module-title" :text "STORAGE" :halign "start")
    (label :class "stat-sub disk-color"
           :text " ${round(EWW_DISK['/'].free / 1073741824, 0)} GiB free  /  ${round(EWW_DISK['/'].total / 1073741824, 0)} GiB"
           :halign "start")
    (stat-bar :value {EWW_DISK["/"].used_perc} :bar-class "disk-bar")
    (label :class "module-title" :text "NETWORK" :halign "start")
    (box :orientation "h" :space-evenly false :halign "start"
      (label :class "net-label" :text " ${net-up}")
      (label :class "net-label" :text "    ${net-down}"))
    (label :class "module-title" :text "AUDIO" :halign "start")
    (label :class "stat-sub"
           :text {muted == "true" ? "󰝟 muted" : " ${volume}%"}
           :halign "start")))


;; ─────────────────────────────────────────────────────────────────────────────
;; Window
;; ─────────────────────────────────────────────────────────────────────────────

(defwindow dashboard
  :monitor 1
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "100%"
    :height "100%"
    :anchor "top left")
  :stacking "bg"
  :exclusive-zone -1
  :namespace "eww-dashboard"
  (box :class "dashboard"
       :orientation "v"
       :space-evenly false
    (clock-widget)
    (box :orientation "h"
         :space-evenly true
         :vexpand true
         :valign "fill"
      (cpu-card)
      (gpu-card)
      (system-card))))
